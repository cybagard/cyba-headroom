#!/usr/bin/env bash
# Blocks commits that mention internal names from outside this public repo
# (other projects, their worktrees and branches, and the home path) or that
# contain likely secrets (API keys, tokens, private keys, URL passwords).
#
#   pre-commit            checks staged file names and added lines
#   commit-msg <file>     checks the commit message
#
# The names are read at commit time and never stored in the repo:
#   - .git/info/scrub-names: one name per line, # comments (local, uncommitted)
#   - Orca (orca worktree ps): other repositories, their worktree folders,
#     branches and display names
#   - $HOME and the user name
#
# Install with `make hooks`, which copies this file into .git/hooks as both
# hooks; re-run it after changing this file. Bypass with --no-verify.
set -euo pipefail
# Bytes, not characters: under a UTF-8 locale macOS cut, grep and awk stop
# at the first invalid byte, and the rest would go unchecked.
export LC_ALL=C

top=$(git rev-parse --show-toplevel)
common=$(git rev-parse --git-common-dir)
terms=$(mktemp)
trap 'rm -f "$terms"' EXIT

if [[ -f $common/info/scrub-names ]]; then
	sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$common/info/scrub-names" | grep -v '^$' >>"$terms" || true
fi

# This repo's own names: never terms. From the origin URL and the top-level
# folder, plus whatever Orca says this worktree belongs to.
origin=$(git remote get-url origin 2>/dev/null || true)
origin=${origin%.git}
own="${origin##*/}
$(basename "$top")"

orca=$(command -v orca || true)
for p in "$HOME/Applications/Orca.app/Contents/Resources/bin/orca" /Applications/Orca.app/Contents/Resources/bin/orca; do
	[[ -z $orca && -x $p ]] && orca=$p
done
if [[ -n $orca ]]; then
	if ! command -v python3 >/dev/null; then
		echo "pre-commit: warning: python3 not found; names from Orca are not checked" >&2
	elif ! "$orca" worktree ps --json 2>/dev/null | TOP="$top" OWN="$own" python3 -c '
import json, os, sys
try:
    rows = json.load(sys.stdin)["result"]["worktrees"]
except Exception:
    sys.exit(3)
top = os.path.realpath(os.environ["TOP"])
own = {n for n in os.environ["OWN"].split("\n") if n}
own |= {r.get("repo") for r in rows if os.path.realpath(r.get("path") or "/") == top}
generic = {"main", "master", "trunk", "develop", "dev", "head"}

def emit(name):
    # Short or generic names would match ordinary words (api in "rapid").
    name = (name or "").strip()
    if len(name) >= 4 and name.lower() not in generic and name not in own:
        print(name)

for r in rows:
    if not r.get("repo") or r.get("repo") in own:
        continue
    emit(r["repo"])
    path = r.get("path") or ""
    emit(os.path.basename(path))
    emit(os.path.basename(os.path.dirname(path)))
    branch = (r.get("branch") or "").removeprefix("refs/heads/")
    emit(branch)
    emit(branch.rsplit("/", 1)[-1])
    emit(r.get("displayName"))
' >>"$terms"; then
		echo "pre-commit: warning: could not read Orca's worktree list; names from Orca are not checked" >&2
	fi
fi

[[ -n ${HOME:-} && $HOME != / ]] && echo "$HOME" >>"$terms"
[[ ${#USER} -ge 6 ]] && echo "$USER" >>"$terms"

sort -u -o "$terms" "$terms"

# lines: "<where>\t<added text>", one per line to scan for secrets.
# text: what is scanned for internal names.
if [[ $# -ge 1 ]]; then
	# commit-msg: drop the diff that `commit -v` adds below the scissors.
	msg=$(sed -E '/^[^ ] -+ >8 -+$/,$d' "$1")
	# Every line is scanned for secrets: with --cleanup=verbatim or another
	# core.commentChar, git keeps lines that start with #.
	lines=$(printf '%s\n' "$msg" | awk '{ print "the commit message\t" $0 }')
	# Names: git strips # lines from the message after this hook runs.
	text=$(printf '%s\n' "$msg" | grep -v '^#' || true)
	what="the commit message"
else
	# Added lines only, tracked by hunk: inside a hunk every line starts with
	# +, - or \, so a content line can never pass for a header. Deleted files
	# are skipped so a leak can be removed. --text, no textconv and no
	# external diff, so attributes cannot hide content.
	added=$(
		git -c core.quotePath=false diff --cached -U0 --no-color --no-ext-diff --no-textconv --text |
			awk '/^diff --git / { hunk = 0; next }
				!hunk && /^\+\+\+ / { f = substr($0, 5); sub(/^"/, "", f); sub(/"$/, "", f); sub(/^b\//, "", f); next }
				/^@@ / { hunk = 1; next }
				hunk && /^\+/ { print f "\t" substr($0, 2) }'
	)
	names=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=d)
	# A file name is published too; report it as "a file name", since the
	# name itself would be the secret.
	lines=$(
		printf '%s\n' "$names" | awk 'NF { print "a file name\t" $0 }'
		printf '%s\n' "$added"
	)
	text=$(printf '%s\n%s\n' "$names" "$(printf '%s\n' "$added" | cut -f2-)")
	what="staged changes"
fi
fail=0

if [[ -s $terms ]]; then
	hits=$(printf '%s\n' "$text" | grep -i -o -F -f "$terms" | sort -u || true)
	if [[ -n $hits ]]; then
		echo "pre-commit: $what mention internal names from outside this public repo:" >&2
		printf '%s\n' "$hits" | sed 's/^/  - /' >&2
		echo "Replace them (e.g. project-a, /Users/dev) or bypass with --no-verify." >&2
		fail=1
	fi
fi

# Secret rules, "name|extended regex". Kept to formats with a fixed prefix
# so ordinary code does not trip them, and anchored on the left (L) so a
# prefix inside a longer word (risk-..., base64...AIza) does not count.
# No \b: BSD grep on macOS lacks it.
L='(^|[^A-Za-z0-9_-])'
rules="AWS access key|(^|[^A-Z0-9])(AKIA|ASIA)[A-Z0-9]{16}([^A-Z0-9]|\$)
GitHub token|${L}(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})
Anthropic API key|${L}sk-ant-[A-Za-z0-9_-]{20,}
OpenAI API key|${L}sk-(proj-|svcacct-|admin-)?[A-Za-z0-9_]{20,}
Slack token|${L}xox[abposr]-[A-Za-z0-9-]{10,}
Google API key|${L}AIza[A-Za-z0-9_-]{35}
Stripe live key|${L}[rs]k_live_[A-Za-z0-9]{20,}
Private key|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----
JSON web token|${L}eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}
Password in a URL|[A-Za-z][A-Za-z0-9+.-]*://[^/:@[:space:]]+:[^/@[:space:]\$<{%][^/@[:space:]]*@"
content=$(printf '%s\n' "$lines" | cut -f2-)
labels=$(printf '%s\n' "$lines" | cut -f1)
found=""
while IFS='|' read -r rule re; do
	# Matching line numbers; grep's 1 means no match, anything above fails.
	nums=$(printf '%s\n' "$content" | { grep -n -E -- "$re" || [[ $? == 1 ]]; } | cut -d: -f1)
	[[ -z $nums ]] && continue
	# Report the rule and where it matched, never the value.
	found+=$(printf '%s\n' "$labels" | awk -v rule="$rule" -v nums="$nums" '
		BEGIN { n = split(nums, a, "\n"); for (i = 1; i <= n; i++) want[a[i]] }
		NR in want { print "  - " rule " in " $0 }')$'\n'
done <<<"$rules"
if [[ -n $found ]]; then
	echo "pre-commit: $what contain possible secrets:" >&2
	printf '%s' "$found" | sort -u >&2
	echo "Remove them and rotate any real credential, or bypass with --no-verify." >&2
	fail=1
fi

exit $fail
