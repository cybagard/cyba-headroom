#!/usr/bin/env bash
# Blocks commits whose added lines or file names mention internal names from
# outside this public repo: other projects, their worktrees, the home path.
# The names are read at commit time, never stored in the repo:
#   - .git/info/scrub-names: one name per line, # comments (local, uncommitted)
#   - Orca (orca worktree ps): other repositories and their worktree folders
#   - $HOME
# Install with `make hooks`. Bypass one commit with `git commit --no-verify`.
set -euo pipefail

top=$(git rev-parse --show-toplevel)
common=$(git rev-parse --git-common-dir)
terms=$(mktemp)
trap 'rm -f "$terms"' EXIT

if [[ -f $common/info/scrub-names ]]; then
	sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$common/info/scrub-names" | grep -v '^$' >>"$terms" || true
fi

orca=$(command -v orca || true)
for p in "$HOME/Applications/Orca.app/Contents/Resources/bin/orca" /Applications/Orca.app/Contents/Resources/bin/orca; do
	[[ -z $orca && -x $p ]] && orca=$p
done
if [[ -n $orca ]] && command -v python3 >/dev/null; then
	"$orca" worktree ps --json 2>/dev/null | TOP="$top" python3 -c '
import json, os, sys
try:
    rows = json.load(sys.stdin)["result"]["worktrees"]
except Exception:
    sys.exit(0)
top = os.path.realpath(os.environ["TOP"])
own = {r.get("repo") for r in rows if os.path.realpath(r.get("path") or "/") == top}
generic = {"main", "master", "trunk", "develop", "dev"}
for r in rows:
    repo = r.get("repo") or ""
    if not repo or repo in own:
        continue
    print(repo)
    name = os.path.basename(r.get("path") or "")
    if len(name) >= 4 and name not in generic and name not in own:
        print(name)
' >>"$terms" || true
fi

[[ -n ${HOME:-} && $HOME != / ]] && echo "$HOME" >>"$terms"

sort -u -o "$terms" "$terms"
[[ -s $terms ]] || exit 0

hits=$( { git diff --cached --name-only; git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | cut -c2-; } | grep -n -F -f "$terms" || true)
if [[ -n $hits ]]; then
	echo "pre-commit: staged changes mention internal names from outside this public repo:" >&2
	echo "$hits" | grep -o -F -f "$terms" | sort -u | sed 's/^/  - /' >&2
	echo "Replace them (e.g. project-a, /Users/dev) or bypass with git commit --no-verify." >&2
	exit 1
fi
